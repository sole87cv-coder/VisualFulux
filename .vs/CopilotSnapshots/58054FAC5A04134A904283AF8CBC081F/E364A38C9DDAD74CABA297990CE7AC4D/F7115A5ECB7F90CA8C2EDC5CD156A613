  float zn = clamp((u_zoom - 0.5) / 2.5, 0.0, 1.0);
  col *= 1.0 - (0.10 + 0.30 * zn) * smoothstep(0.35, 1.6, length(uv0));


  float lum = dot(col, LUMA);
  col *= min(1.0, 0.85 / max(lum, 0.0001));
  gl_FragColor = vec4(col, 1.0);
}`;

