      verts.forEach(function (v) { best = Math.max(best, dot(v, n)); });
      verts.forEach(function (v, vi) { if (dot(v, n) > best - 1e-3) idx.push(vi); });
      var t = Math.abs(n[0]) < 0.9 ? [1, 0, 0] : [0, 1, 0];
