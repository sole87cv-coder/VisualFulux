    } catch (e) { gl = null; }
    if (!gl) return null;

    var vs = compile(gl, gl.VERTEX_SHADER, VERT), fs = compile(gl, gl.FRAGMENT_SHADER, FRAG);
    if (!vs || !fs) return null;
    var prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      if (window.console) console.warn('[v1su4rt] link:', gl.getProgramInfoLog(prog));
      return null;
    }
    gl.useProgram(prog);

    // triângulo que cobre a tela inteira
    var buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    var loc = gl.getAttribLocation(prog, 'a_pos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    var names = ['u_res', 'u_time', 'u_flow', 'u_audio', 'u_bass', 'u_mid', 'u_treble', 'u_solidity',
                 'u_light', 'u_zoom', 'u_tilt', 'u_eco', 'u_ca', 'u_scale', 'u_rot'];
    var U = {};
    names.forEach(function (n) { U[n] = gl.getUniformLocation(prog, n); });

    cv.addEventListener('webglcontextlost', function (e) {
      e.preventDefault();
      switchTo2D();
    }, false);

    return {
      kind: 'webgl',
      resize: function (w, h) { gl.viewport(0, 0, w, h); },
      draw: function (S) {
        gl.uniform2f(U.u_res, cv.width, cv.height);
        gl.uniform1f(U.u_time, S.time);
        gl.uniform1f(U.u_flow, S.flow);
        gl.uniform1f(U.u_audio, S.audio);
        gl.uniform1f(U.u_bass, S.bass);
        gl.uniform1f(U.u_mid, S.mid);
        gl.uniform1f(U.u_treble, S.treble);
        gl.uniform1f(U.u_solidity, S.solidity);
        gl.uniform1f(U.u_light, S.light);
        gl.uniform1f(U.u_zoom, S.zoom);
        gl.uniform2f(U.u_tilt, S.tx, S.ty);
        gl.uniform1f(U.u_eco, S.eco);
        gl.uniform1f(U.u_ca, S.ca);
        gl.uniform1f(U.u_scale, S.scale);
        gl.uniformMatrix3fv(U.u_rot, false, S.mCol);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      }
    };
  }

  // --- Renderer Canvas2D (fallback): mesma geometria, rotação, zoom e luz ---
  function rgba(c, a) {
    return 'rgba(' + Math.round(clamp01(c[0]) * 255) + ',' + Math.round(clamp01(c[1]) * 255) + ',' +
           Math.round(clamp01(c[2]) * 255) + ',' + clamp01(a).toFixed(3) + ')';
  }

  function create2D(cv) {
    var c = null;
    try { c = cv.getContext('2d', { alpha: false }); } catch (e) { c = null; }
    if (!c) return null;
    var EDGE = [0.74, 0.85, 0.98];

    function background(w, h, S) {
      var half = h / 2, gi = 1 + 0.4 * S.light;
      c.globalAlpha = 1;
      c.fillStyle = '#0a0c10';
      c.fillRect(0, 0, w, h);

      var lg = c.createLinearGradient(0, 0, w, h);
      lg.addColorStop(0, rgba(COL_A, 0.05 * gi));
      lg.addColorStop(1, rgba(COL_B, 0.07 * gi));
      c.fillStyle = lg;
      c.fillRect(0, 0, w, h);

      // halo: cresce com a luz; graves esquentam para magenta
      var I = 0.7 * Math.pow(Math.max(S.light, 0.0001), 1.15);
      if (I > 0.004) {
        var hx = w / 2 + S.tx * 0.04 * half, hy = h / 2 - S.ty * 0.04 * half;
        var r = half * (0.22 + 0.85 * S.light) * 1.5;
        var hc = [mix(0.36, 0.88, clamp01(S.bass * 0.75)), mix(0.55, 0.30, clamp01(S.bass * 0.75)), mix(1.0, 0.8, clamp01(S.bass * 0.75))];
        var rg = c.createRadialGradient(hx, hy, 0, hx, hy, r);
        rg.addColorStop(0, rgba(hc, 0.6 * I));
        rg.addColorStop(1, rgba(hc, 0));
        c.fillStyle = rg;
        c.fillRect(0, 0, w, h);
      }

      // faíscas nos agudos
      if (S.treble > 0.05) {
        var sd = Math.floor(S.flow * 3), n, sz = Math.max(1, h / 500);
        c.fillStyle = rgba([0.7, 0.85, 1.0], 0.5 * S.treble);
        for (n = 1; n <= 28; n++) {
          c.fillRect(Math.abs(Math.sin(n * 91.7 + sd * 3.3) * 4e4 % 1) * w, Math.abs(Math.sin(n * 47.3 + sd * 7.1) * 2e4 % 1) * h, sz, sz);
        }
      }
    }

    return {
      kind: '2d',
      resize: function () {},
      draw: function (S) {
        var w = cv.width, h = cv.height, cx = w / 2, cy = h / 2, half = h / 2;
        var u = Math.max(1, h / 600), i, j;
        background(w, h, S);

        // projeção: mundo = Mt·v·escala; tela = zoom·FOCAL·(x,y)/(z+D)
        var m = S.mRow, k = S.zoom * FOCAL * half;
        var px = [], py = [], dz = [];
        for (i = 0; i < GEO.verts.length; i++) {
          var v = GEO.verts[i];
          var x = (m[0] * v[0] + m[3] * v[1] + m[6] * v[2]) * S.scale;
          var y = (m[1] * v[0] + m[4] * v[1] + m[7] * v[2]) * S.scale;
          var z = (m[2] * v[0] + m[5] * v[1] + m[8] * v[2]) * S.scale + CAM_D;
          px.push(cx + k * x / z);
          py.push(cy - k * y / z);
          dz.push(z);
        }

        function drawEdges(far, alpha) {
          c.lineCap = 'round';
          for (j = 0; j < GEO.edges.length; j++) {
            var e = GEO.edges[j], isFar = (dz[e[0]] + dz[e[1]]) / 2 > CAM_D;
            if (isFar !== far) continue;
            c.beginPath();
            c.moveTo(px[e[0]], py[e[0]]);
            c.lineTo(px[e[1]], py[e[1]]);
            c.strokeStyle = rgba(EDGE, alpha * (0.1 + 0.25 * S.audio));   // brilho
            c.lineWidth = (5 + 6 * S.audio) * u;
            c.stroke();
            var tb = S.treble * 0.6;   // agudos: arestas ficam mais brancas
            c.strokeStyle = rgba([mix(EDGE[0], 1, tb), mix(EDGE[1], 1, tb), mix(EDGE[2], 1, tb)], alpha * 0.9);
            c.lineWidth = 1.5 * u;
            c.stroke();
          }
        }

        drawEdges(true, 0.55);   // arestas do fundo, vistas através do sólido

        if (!S.eco) {            // faces: alpha 0.02 (silêncio) até ~0.9 (som alto)
          var alpha = 0.02 + 0.88 * S.solidity, order = [];
          for (i = 0; i < GEO.faces.length; i++) {
            var f = GEO.faces[i], zs = 0;
            for (j = 0; j < 5; j++) zs += dz[f.idx[j]];
            order.push({ f: f, z: zs / 5 });
          }
          order.sort(function (a, b) { return b.z - a.z; });   // de trás para frente
          for (i = 0; i < order.length; i++) {
            var face = order[i].f;
            var nz = clamp01(0.5 + 0.5 * Math.sin(face.hash * 40 + S.time * 0.6) + (face.hash - 0.5) * 0.3 + S.mid * 0.25);
            var col = [mix(COL_A[0], COL_B[0], nz), mix(COL_A[1], COL_B[1], nz), mix(COL_A[2], COL_B[2], nz)];
            var mb = clamp(S.bass * 0.7, 0, 0.7);
            col = [mix(col[0], COL_M[0], mb), mix(col[1], COL_M[1], mb), mix(col[2], COL_M[2], mb)];
            var shade = 0.6 + 0.6 * S.solidity + 0.3 * S.light;
            col = [col[0] * shade, col[1] * shade, col[2] * shade];
            c.beginPath();
            for (j = 0; j < 5; j++) {
              var vi = face.idx[j];
              if (j === 0) c.moveTo(px[vi], py[vi]); else c.lineTo(px[vi], py[vi]);
            }
            c.closePath();
            c.fillStyle = rgba(col, order[i].z > CAM_D ? alpha * 0.55 : alpha);
            c.fill();
          }
        }

        drawEdges(false, 1.0);   // arestas da frente

        // vértices: pontos que crescem com os agudos
        var vr = (2.2 + 4.5 * S.treble) * u;
        c.fillStyle = rgba([0.88, 0.94, 1.0], 0.8 + 0.2 * S.treble);
        for (i = 0; i < px.length; i++) {
          c.beginPath();
          c.arc(px[i], py[i], vr, 0, TAU);
          c.fill();
        }

        // vignette que cresce com o zoom
        var zn = clamp((S.zoom - 0.5) / 2.5, 0, 1);
        var vg = c.createRadialGradient(cx, cy, half * 0.5, cx, cy, Math.sqrt(cx * cx + cy * cy));
        vg.addColorStop(0, 'rgba(0,0,0,0)');
        vg.addColorStop(1, 'rgba(0,0,0,' + (0.10 + 0.30 * zn).toFixed(3) + ')');
        c.fillStyle = vg;
        c.fillRect(0, 0, w, h);
      }
    };
  }

  // --- Loop, pausa (visibilidade + IntersectionObserver) e qualidade adaptativa ---
  var running = false, raf = 0, pageVisible = true, inView = true;
  var lastDraw = 0, fpsN = 0, fpsT = 0, warm = 0, io = null;

  function nowMs() { return (window.performance && performance.now) ? performance.now() : Date.now(); }

  function frame(now) {
    raf = 0;
    if (!running) return;
    raf = requestAnimationFrame(frame);
    if (eco && now - lastDraw < 1000 / 30 - 3) return;       // modo econômico: 30 fps
    var dt = Math.min(0.1, Math.max(0.001, (now - lastDraw) / 1000));
    lastDraw = now;
    var S = step(dt, now);
    if (renderer) {
      try { renderer.draw(S); } catch (e) { if (window.console) console.warn('[v1su4rt] draw:', e); }
    }

    // resolução adaptativa: abaixo de ~40 fps (25 no eco) reduz a escala interna
    fpsN++;
    if (now - fpsT >= 1200) {
      var fps = fpsN * 1000 / (now - fpsT);
      fpsN = 0; fpsT = now; warm++;
      if (warm > 2 && fps < (eco ? 25 : 38) && quality > 0.5) {
        quality = Math.max(0.5, quality * 0.85);
        fitCanvas();
      }
    }
  }

  function updateRunning() {
    var want = pageVisible && inView && !!renderer;
    if (want === running) return;
    running = want;
    if (running) {
      lastDraw = nowMs(); fpsT = lastDraw; fpsN = 0;
      if (!raf) raf = requestAnimationFrame(frame);
    } else if (raf) {
      cancelAnimationFrame(raf);
      raf = 0;
    }
  }

  function observe() {
    if (io) { io.disconnect(); io = null; }
    if ('IntersectionObserver' in window && canvas) {
      io = new IntersectionObserver(function (entries) {
        inView = entries[entries.length - 1].isIntersecting;
        updateRunning();
      }, { threshold: 0 });
      io.observe(canvas);
    }
  }

  function switchTo2D() {
    running = false;
    if (raf) { cancelAnimationFrame(raf); raf = 0; }
    canvas = replaceCanvas(canvas);
    renderer = create2D(canvas);
    fitCanvas();
    observe();
    updateRunning();
  }

  function init() {
    canvas = document.getElementById('stage');
    if (!canvas) return;
    renderer = createGL(canvas);
    if (!renderer) {
      canvas = replaceCanvas(canvas);
      renderer = create2D(canvas);
    }
    fitCanvas();
    if ('ResizeObserver' in window) new ResizeObserver(fitCanvas).observe(document.documentElement);
    window.addEventListener('resize', fitCanvas);
    window.addEventListener('orientationchange', function () { setTimeout(fitCanvas, 150); });
    document.addEventListener('visibilitychange', function () {
      pageVisible = !document.hidden;
      updateRunning();
    });
    pageVisible = !document.hidden;
    observe();
    updateRunning();
  }

  // --- API pública ---
  window.v1su4rtShaders = {
    setAudio: setAudio,
    renderer: function () { return renderer ? renderer.kind : 'none'; },
    _geometry: GEO,
    _internals: { step: step, rotMatrix: rotMatrix, create2D: create2D, asciiOnly: asciiOnly, FRAG: FRAG, VERT: VERT }
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
