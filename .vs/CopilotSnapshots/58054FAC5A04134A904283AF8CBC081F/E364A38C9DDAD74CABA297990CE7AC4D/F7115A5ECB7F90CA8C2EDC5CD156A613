  float pix = 2.0 / u_res.y;
  vec3 col = background(uv0);


  vec2 uv = uv0 / u_zoom;
  vec3 ro = (u_rot * vec3(0.0, 0.0, -CAM_D)) / u_scale;
  vec3 rd = u_rot * normalize(vec3(uv, FOCAL));


  float tN = -1.0e4;
  float tF = 1.0e4;
  float fN = 0.0;
  float fF = 0.0;
  bool miss = false;
  for (int i = 0; i < 12; i++) {
    float fi = float(i);
    vec3 n = faceN(fi);
    float dn = dot(n, rd);
    float num = INR - dot(n, ro);
    if (abs(dn) < 1.0e-5) {
      if (num < 0.0) miss = true;
    } else {
      float t = num / dn;
      if (dn < 0.0) { if (t > tN) { tN = t; fN = fi; } }
      else          { if (t < tF) { tF = t; fF = fi; } }
    }
  }

  if (!miss && tN < tF && tF > 0.0) {
    float aaK = pix / u_zoom / FOCAL;
    float caAmt = u_ca * smoothstep(0.3, 1.4, length(uv0));
    vec3 L = normalize(u_rot * vec3(-0.45, 0.6, -0.65));
    vec3 pN = ro + rd * tN;
    vec3 pF = ro + rd * tF;
    vec3 nN = faceN(fN);
    vec3 nF = faceN(fF);
    float aaN = tN * aaK / max(abs(dot(nN, rd)), 0.25);
    float aaF = tF * aaK / max(abs(dot(nF, rd)), 0.25);
    vec2 mN = edgeDist(pN, fN);
    vec2 mF = edgeDist(pF, fF);


    float aFront = (1.0 - u_eco) * (0.02 + 0.88 * u_solidity);
    float aBack = aFront * 0.55;

    if (aBack > 0.001) col = mix(col, shadeFace(pF, nF, fF, rd, L) * 0.75, aBack);
    col += edgeLayer(mF, aaF, caAmt) * 0.55;
    if (aFront > 0.001) col = mix(col, shadeFace(pN, nN, fN, rd, L), aFront);
    col += edgeLayer(mN, aaN, caAmt);
