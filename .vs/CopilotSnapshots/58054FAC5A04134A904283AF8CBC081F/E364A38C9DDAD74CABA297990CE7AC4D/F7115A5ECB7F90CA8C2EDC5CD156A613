  var PHI = (1 + Math.sqrt(5)) / 2;
  var CAM_D = 7.0;            // distância da câmera ao centro do dodecaedro
  var FOCAL = 1.4;            // distância focal da projeção perspectiva
  var TAU = Math.PI * 2;
  var TIME_WRAP = 400 * Math.PI;   // múltiplo exato dos períodos usados no GLSL
  var FLOW_WRAP = 10 * Math.PI;    // idem, para a fase do gradiente de fundo

  var COL_A = [0x5b / 255, 0x8c / 255, 1.0];       // accent   #5b8cff
  var COL_B = [0xa3 / 255, 0x7b / 255, 1.0];       // accent-2 #a37bff
  var COL_M = [0.92, 0.27, 0.92];                  // magenta/violeta (graves)

  function clamp(x, a, b) { return x < a ? a : (x > b ? b : x); }
  function clamp01(x) { return clamp(x, 0, 1); }
  function mix(a, b, t) { return a + (b - a) * t; }
  function smooth(a, b, x) { var t = clamp01((x - a) / (b - a)); return t * t * (3 - 2 * t); }
  function num(x, d) { x = +x; return isFinite(x) ? x : d; }

  // --- Geometria do dodecaedro (usada pelo fallback e validada nos testes) ---
  function buildGeometry() {
    var inv = 1 / PHI, verts = [], edges = [], normals = [], faces = [];
    var i, j, k, g, s;

    // 20 vértices: (±1,±1,±1), (0,±1/φ,±φ), (±1/φ,±φ,0), (±φ,0,±1/φ)
    for (i = -1; i <= 1; i += 2) for (j = -1; j <= 1; j += 2) for (k = -1; k <= 1; k += 2) verts.push([i, j, k]);
    for (i = -1; i <= 1; i += 2) for (j = -1; j <= 1; j += 2) {
      verts.push([0, i * inv, j * PHI]);
      verts.push([i * inv, j * PHI, 0]);
      verts.push([j * PHI, 0, i * inv]);
    }

    // 30 arestas: pares de vértices à distância 2/φ
    function dist(a, b) { return Math.sqrt(Math.pow(a[0] - b[0], 2) + Math.pow(a[1] - b[1], 2) + Math.pow(a[2] - b[2], 2)); }
    for (i = 0; i < verts.length; i++) {
      for (j = i + 1; j < verts.length; j++) {
        if (Math.abs(dist(verts[i], verts[j]) - 2 * inv) < 1e-3) edges.push([i, j]);
      }
    }

    // 12 normais de face, na mesma ordem de faceN() no GLSL
    var nn = 1 / Math.sqrt(1 + PHI * PHI);
    for (g = 0; g < 3; g++) {
      for (s = 0; s < 4; s++) {
        var sa = s < 2 ? 1 : -1, sb = (s % 2 === 0) ? 1 : -1, v;
        if (g === 0) v = [sa, 0, sb * PHI];
        else if (g === 1) v = [sb * PHI, sa, 0];
        else v = [0, sb * PHI, sa];
        normals.push([v[0] * nn, v[1] * nn, v[2] * nn]);
      }
    }

    // 12 faces pentagonais: os 5 vértices mais alinhados com a normal, em ordem
    function dot(a, b) { return a[0] * b[0] + a[1] * b[1] + a[2] * b[2]; }
    function cross(a, b) { return [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]]; }
    function norm(a) { var l = Math.sqrt(dot(a, a)); return [a[0] / l, a[1] / l, a[2] / l]; }
    normals.forEach(function (n, fi) {
