uniform float u_time;      // tempo (com wrap seguro)
uniform float u_flow;      // fase do gradiente de fundo (acumulada no JS)
uniform float u_audio;
uniform float u_bass;
uniform float u_mid;
uniform float u_treble;
uniform float u_solidity;  // 0 = transparente, 1 = sólido
uniform float u_light;     // luz emitida = audio*0.7 + bass*0.3
uniform float u_zoom;
uniform vec2  u_tilt;      // giroscópio suavizado (-1..1)
uniform float u_eco;       // 1 = modo econômico (só wireframe)
uniform float u_ca;        // intensidade da aberração cromática
uniform float u_scale;     // escala do sólido (0.8 .. 1.6)
uniform mat3  u_rot;       // objeto <- mundo

const float PHI = 1.6180339887;
const float INR = 1.3763819205;       // raio inscrito (distância centro-face)
const float NRM = 0.5257311121;       // 1/sqrt(1+PHI^2)
const float INV_SIN = 1.1180339887;   // 1/sin(ângulo entre normais vizinhas)
const float CAM_D = 7.0;
const float FOCAL = 1.4;
const vec3 COL_A = vec3(0.357, 0.549, 1.0);   // #5b8cff
const vec3 COL_B = vec3(0.639, 0.482, 1.0);   // #a37bff
const vec3 COL_M = vec3(0.92, 0.27, 0.92);
const vec3 COL_EDGE = vec3(0.74, 0.85, 0.98);
const vec3 BG = vec3(0.0392, 0.0471, 0.0627); // #0a0c10
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// Normal da face i (0..11): (±1,0,±PHI) e permutações cíclicas
vec3 faceN(float i) {
  float g = floor(i / 4.0);
  float s = i - g * 4.0;
  float sa = (s < 2.0) ? 1.0 : -1.0;
  float sb = (mod(s, 2.0) < 1.0) ? 1.0 : -1.0;
  vec3 v = (g < 0.5) ? vec3(sa, 0.0, sb * PHI)
         : ((g < 1.5) ? vec3(sb * PHI, sa, 0.0) : vec3(0.0, sb * PHI, sa));
  return v * NRM;
}

float hash11(float n) { return fract(sin(n * 12.9898) * 43758.5453); }
float hash21(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }

// Ruído interno barato (senoides entrelaçadas), sem textura
float pnoise(vec3 p, float t) {
  return 0.5 + 0.5 * sin(dot(p, vec3(2.1, 1.7, 2.6)) + t * 0.6
                         + 1.5 * sin(dot(p, vec3(1.3, -2.2, 1.9)) - t * 0.4));
}

// Distância (no plano da face f) até as duas arestas mais próximas.
// As faces vizinhas têm n_i·n_j = 1/sqrt(5), então a distância até a aresta
// compartilhada é (INR - n_j·p) / sin(ângulo). Dá as 30 arestas sem lista.
vec2 edgeDist(vec3 p, float f) {
  vec3 nf = faceN(f);
  float m1 = 9.0;
  float m2 = 9.0;
  for (int j = 0; j < 12; j++) {
    float fj = float(j);
    vec3 nj = faceN(fj);
    if (fj != f && dot(nj, nf) > 0.3) {
      float e = (INR - dot(nj, p)) * INV_SIN;
      if (e < m1) { m2 = m1; m1 = e; } else if (e < m2) { m2 = e; }
    }
  }
  return vec2(m1, m2);
}

// Fundo: gradiente escuro + halo central iluminado por u_light
vec3 background(vec2 uv) {
  float L = u_light;
  vec2 p = uv + u_tilt * 0.06;
  float g = 0.5 + 0.5 * sin(p.x * 1.3 + u_flow) * cos(p.y * 1.1 - u_flow * 0.8 + p.x * 0.4);
  g = g * 0.65 + 0.35 * smoothstep(-1.3, 1.3, p.y * 0.8 + p.x * 0.3);
  vec3 gradCol = mix(BG, vec3(0.085, 0.07, 0.17), g * 0.7);
  vec3 col = BG + (gradCol - BG) * (1.0 + 0.4 * L);


  vec2 q = uv - u_tilt * 0.04;
  float r = 0.22 + 0.85 * L;
  float halo = exp(-dot(q, q) / (r * r * 0.45)) * 0.7 * pow(max(L, 0.0001), 1.15);
  vec3 hcol = mix(vec3(0.36, 0.55, 1.0), vec3(0.88, 0.30, 0.80), clamp(u_bass * 0.75, 0.0, 1.0));
  col += hcol * halo * 0.8;


  vec2 sc = p * vec2(26.0, 15.0) + vec2(0.0, -u_flow * 1.5);
  vec2 cell = floor(sc);
  float h = hash21(cell);
  float spot = 1.0 - smoothstep(0.0, 0.26, length(fract(sc) - 0.5));
  float spark = step(0.965, h) * spot * (0.5 + 0.5 * sin(u_time * 14.0 + h * 60.0));
  col += vec3(0.70, 0.85, 1.0) * spark * u_treble * (0.25 + g) * 0.6;
  return col;
}

// Arestas + vértices; a aberração desloca os canais R e B em sentidos opostos
vec3 edgeLayer(vec2 m, float aa, float ca) {
  float lw = aa * 1.3;
  vec3 d = vec3(m.x) + vec3(-ca, 0.0, ca) * aa * 2.2;
  vec3 line = 1.0 - smoothstep(vec3(lw), vec3(lw + aa * 1.2), d);
  vec3 glow = exp(-max(d, 0.0) / (aa * (5.0 + 12.0 * u_audio))) * (0.10 + 0.45 * u_audio);
  vec3 ecol = mix(COL_EDGE, vec3(1.0), u_treble * 0.6);
  vec3 outc = ecol * (line * 0.9 + glow) * (1.0 + 0.7 * u_treble);
  float vd = length(m);
  float vr = aa * (2.6 + 6.0 * u_treble);
  float v = 1.0 - smoothstep(vr * 0.55, vr, vd);
  float vg = exp(-vd / (vr * 1.6)) * 0.35 * (0.4 + u_treble);
  outc += vec3(0.88, 0.94, 1.0) * (v + vg) * (0.8 + 0.8 * u_treble);
  return outc;
}

// Cor da face: mix(accent, accent-2, ruído), graves puxam para magenta
vec3 shadeFace(vec3 p, vec3 n, float f, vec3 rdv, vec3 L) {
  float warp = smoothstep(0.7, 1.0, u_solidity);
  vec3 q = p * 1.5 + warp * 0.35 * vec3(sin(p.y * 4.0 + u_time * 1.3), sin(p.z * 4.0 - u_time * 1.1), sin(p.x * 4.0 + u_time));
  float nz = clamp(pnoise(q, u_time) + (hash11(f) - 0.5) * 0.3 + u_mid * 0.25, 0.0, 1.0);
  vec3 c = mix(COL_A, COL_B, nz);
  c = mix(c, COL_M, clamp(u_bass * 0.7, 0.0, 0.7));
  float dif = 0.35 + 0.65 * max(dot(n, L), 0.0);
  float fres = pow(1.0 - abs(dot(n, rdv)), 2.0);
  c = c * dif * (0.55 + 0.75 * u_solidity + 0.4 * u_light)
      + fres * mix(COL_A, COL_EDGE, 0.5) * 0.35 * (0.3 + u_solidity);
  float l = dot(c, LUMA);
  return mix(vec3(l), c, 1.0 + 0.5 * u_solidity);
}

void main() {
