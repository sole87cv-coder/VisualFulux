:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#17233c;background:#f6f8fd;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;font-optical-sizing:auto;font-weight:400;--ink:#17233c;--muted:#66738c;--blue:#2469f5;--line:#e3e9f3;--shell:1160px}
*{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:88px}
body{margin:0;min-width:320px;background:#f6f8fd;color:var(--ink);line-height:1.55}
a{color:inherit}
button{font:inherit}
.shell{width:min(var(--shell),calc(100% - 48px));margin-inline:auto}
.skip-link{position:absolute;left:12px;top:-60px;z-index:20;background:white;padding:10px 14px;border-radius:10px}
.skip-link:focus{top:12px}
.site-header{height:76px;position:sticky;top:0;z-index:10;background:#f6f8fddd;border-bottom:1px solid #e7ecf4;backdrop-filter:blur(16px)}
.header-inner{height:100%;display:flex;align-items:center;justify-content:space-between}
.brand{display:inline-flex;gap:11px;align-items:center;text-decoration:none;font-size:14px;font-weight:780;letter-spacing:.09em}
.brand-dash{color:#9aa8bf;margin:0 2px}
.brand-mark{height:28px;width:28px;display:flex;gap:3px;align-items:end;padding:5px;border-radius:9px;background:linear-gradient(145deg,#4081ff,#1c54d7);box-shadow:0 6px 14px #2469f533}
.brand-mark span{display:block;width:4px;border-radius:5px;background:#fff}
.brand-mark span:nth-child(1){height:9px}.brand-mark span:nth-child(2){height:15px}.brand-mark span:nth-child(3){height:11px}
.top-nav{display:flex;align-items:center;gap:30px;font-size:13px;color:#53617a}
.top-nav>a,.mobile-nav>a{ text-decoration:none;transition:color .18s}.top-nav>a:hover,.mobile-nav>a:hover{color:var(--blue)}
.button{min-height:46px;display:inline-flex;justify-content:center;align-items:center;gap:12px;border:0;border-radius:13px;padding:0 18px;text-decoration:none;font-size:13px;font-weight:680;cursor:pointer;transition:transform .18s,box-shadow .18s,background .18s}
.button:hover{transform:translateY(-2px)}.button:focus-visible,a:focus-visible{outline:3px solid #8bb4ff;outline-offset:3px}
.button-small{min-height:38px;padding:0 14px;border-radius:11px;background:#e9efff;color:#225bd1}.button-primary{color:#fff;background:linear-gradient(105deg,#3479ff,#205de3);box-shadow:0 10px 24px #2469f52e}.button-primary:hover{box-shadow:0 13px 28px #2469f545}.button-dark{color:#fff;background:#192844}.button-dark:hover{background:#25406f}
.menu-button{display:none;width:42px;height:42px;border:1px solid var(--line);border-radius:12px;background:white;align-items:center;justify-content:center;flex-direction:column;gap:5px}.menu-button span{width:16px;height:2px;background:#35425b;border-radius:2px}
.mobile-nav{padding:8px 24px 18px;background:#f6f8fd;border-bottom:1px solid var(--line)}.mobile-nav>a{display:block;padding:12px 0;font-size:14px;color:#53617a}.mobile-nav button{margin-top:8px}
.hero{min-height:620px;display:grid;grid-template-columns:1fr 1.03fr;align-items:center;gap:40px;padding-top:38px;padding-bottom:66px}
.hero-copy{position:relative;z-index:1;padding:12px 0 16px}
.eyebrow{margin:0 0 17px;display:flex;align-items:center;gap:9px;color:#60718e;font-size:10px;font-weight:800;letter-spacing:.17em}
.pulse-dot,.size-dot{width:7px;height:7px;border-radius:50%;background:#3b80ff;box-shadow:0 0 0 4px #3b80ff18}
h1,h2,h3,p{margin-top:0}
h1{max-width:570px;margin-bottom:19px;font-size:clamp(42px,5.6vw,70px);line-height:1.03;letter-spacing:-.065em;font-weight:690}
h1 span,.section-heading h2 span,.demo-copy h2 span{color:#7895c5}
.hero-text{max-width:465px;margin-bottom:27px;color:#697690;font-size:16px;line-height:1.75}
.hero-actions{display:flex;align-items:center;gap:22px;flex-wrap:wrap}.text-link{display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-size:13px;font-weight:650;color:#40516f}.text-link:hover{color:var(--blue)}
.hero-note{display:flex;align-items:center;gap:10px;margin-top:38px;color:#8a96aa;font-size:11px}.note-icon{height:23px;width:23px;display:grid;place-items:center;border-radius:8px;background:#e9effb;color:#4778ce;font-size:13px}
.hero-art{height:470px;position:relative;display:grid;place-items:center;isolation:isolate}.art-glow{position:absolute;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,#c4d8ff 0,#e2ecff 35%,#f2f6ff00 72%);z-index:-1}
.orbit{position:absolute;border:1px solid #c7d8f8;border-radius:50%;transform:rotate(-25deg)}.orbit-one{width:440px;height:180px}.orbit-two{width:360px;height:310px;transform:rotate(42deg);border-color:#dae5f7}
.device{position:absolute;border:1px solid #d7e1f1;background:#fff;box-shadow:0 26px 65px #455e8820}.device-back{width:192px;height:288px;left:14%;top:21%;border-radius:18px;transform:rotate(-10deg);padding:17px;opacity:.83}.device-top{height:9px;width:45px;border-radius:10px;background:#e6ecf5;margin:0 auto 18px}.mini-line{height:7px;width:54%;margin:11px 0;background:#e7edf7;border-radius:6px}.mini-line.wide{width:83%;height:11px;background:#bacbf0}.mini-card{height:108px;margin-top:19px;border-radius:12px;background:linear-gradient(135deg,#d8e5ff,#f1eaff)}
.device-front{width:240px;height:337px;right:14%;top:14%;border-radius:24px;padding:17px 19px;transform:rotate(7deg);box-shadow:0 30px 65px #33476c2c}.device-front .device-top{width:48px;height:5px;margin-bottom:30px;background:#edf1f7}.device-front .device-top i{display:none}
.preview-tag{font-size:8px;font-weight:800;letter-spacing:.15em;color:#71829f}.preview-tag b{color:#3173f1}.preview-heading{margin-top:23px;font-size:32px;font-weight:720;line-height:1.04;letter-spacing:-.06em}.preview-heading em{font-style:normal;color:#5085f3}.preview-line{width:106px;height:5px;background:#e1e8f4;border-radius:6px;margin-top:16px}.preview-button{height:22px;width:77px;border-radius:7px;background:#2d6ff0;margin-top:20px}.preview-orb{position:absolute;bottom:20px;right:16px;width:105px;height:105px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#f1ceff,#9cafff 48%,#6587e4);box-shadow:inset -8px -12px 20px #506ac04a,0 12px 30px #718fe14d}
.floating-badge{position:absolute;z-index:2;display:flex;align-items:center;gap:8px;padding:10px 13px;border:1px solid #e0e7f3;border-radius:12px;background:#ffffffeb;box-shadow:0 10px 25px #31436512;font-size:10px;font-weight:650;color:#586985}.floating-badge span{display:grid;place-items:center;width:18px;height:18px;border-radius:6px;background:#edf3ff;color:#3173f1;font-size:13px}.badge-mobile{left:5%;bottom:17%}.badge-ready{right:3%;top:22%}
.feature-section{padding:84px 0 88px;background:#fff;border-top:1px solid #edf1f7;border-bottom:1px solid #edf1f7}
.section-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:34px}.section-heading .eyebrow,.demo-copy .eyebrow{margin-bottom:12px}.section-heading h2,.demo-copy h2{margin:0;font-size:clamp(31px,4vw,44px);line-height:1.12;letter-spacing:-.055em}.section-heading>p{max-width:330px;margin:0 0 4px;color:#7a879b;font-}

/* Ajustes mobile-first simples */
@media (max-width: 720px) {
  .top-nav { display: none; }
  .menu-button { display: flex; }
  .hero { grid-template-columns: 1fr; min-height: auto; gap: 20px; padding-top: 20px; padding-bottom: 40px; }
  .hero-art { display: none; }
  .feature-grid { grid-template-columns: 1fr; }
  .shell { width: calc(100% - 32px); }
  .preview-stage { margin-top: 16px; }
}

/* Toast básico para mensagens */
.toast{position:fixed;left:50%;transform:translateX(-50%) translateY(24px);bottom:12px;background:#192844;color:#fff;padding:10px 16px;border-radius:12px;box-shadow:0 8px 24px #22345855;opacity:0;pointer-events:none;transition:opacity .28s,transform .28s;z-index:60}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* Estilos para painel de interação */
.interaction-panel{margin-top:18px;display:flex;flex-direction:column;gap:10px;align-items:flex-start}
#interaction-canvas{width:100%;border-radius:12px;display:block}
.interaction-note{margin:0;font-size:13px;color:var(--muted)}

@media (max-width:720px){
  #interaction-canvas{height:200px}
}

.interaction-controls{display:flex;flex-direction:column;gap:8px;width:100%;max-width:420px}
.interaction-controls label{font-size:12px;color:var(--muted);display:flex;justify-content:space-between}
.interaction-controls input[type="range"]{-webkit-appearance:none;height:6px;border-radius:6px;background:#e6eefc;width:100%}
.interaction-controls input[type="range"]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:50%;background:#3173f1;box-shadow:0 2px 6px rgba(49,115,241,0.35)}
